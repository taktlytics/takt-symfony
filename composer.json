{
    "name": "vskstudio/takt-symfony",
    "description": "Symfony bundle for Takt analytics: takt() Twig function + autowired Takt service for server-side events.",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": [
        "analytics",
        "takt",
        "symfony",
        "privacy",
        "tracking",
        "twig"
    ],
    "homepage": "https://github.com/taktlytics/takt-symfony",
    "authors": [
        {
            "name": "vskstudio"
        }
    ],
    "support": {
        "issues": "https://github.com/taktlytics/takt-symfony/issues",
        "source": "https://github.com/taktlytics/takt-symfony"
    },
    "require": {
        "php": ">=8.1",
        "vskstudio/takt-core-php": "^0.6",
        "symfony/framework-bundle": "^6.4 || ^7.0",
        "symfony/http-client": "^6.4 || ^7.0",
        "nyholm/psr7": "^1.8"
    },
    "require-dev": {
        "symfony/twig-bundle": "^6.4 || ^7.0",
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.59"
    },
    "autoload": {
        "psr-4": {
            "Vskstudio\\Takt\\Symfony\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vskstudio\\Takt\\Symfony\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable"
}
